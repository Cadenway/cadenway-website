{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Patch, pin and digest updates merge on their own once CI is green.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Group updates to Cadenway packages.",
      "matchPackageNames": ["@cadenway/**"],
      "groupName": "cadenway packages"
    },
    {
      "description": "@angular/aria peers on an exact @angular/cdk version: the two move together.",
      "matchPackageNames": ["@angular/cdk", "@angular/aria"],
      "groupName": "angular cdk and aria"
    },
    {
      "description": "TypeScript stays on 6.0 until Angular and typescript-eslint accept a newer line.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    }
  ]
}
